{
  "name": "cruiseread",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "coverage": "node --import tsx scripts/coverage.ts",
    "decks:check": "node --import tsx scripts/decks-check.ts",
